<div class="w-full flex flex-col items-center justify-center min-h-screen bg-base-200 p-8">
  <div class="max-w-7xl w-full flex flex-col gap-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-4xl font-bold text-base-content">ODT Booking</h1>
      </div>
      <div class="flex items-center space-x-4">
        <% if current_user %>
          <div class="flex flex-col text-right">
            <span class="text-sm font-bold"><%= current_user.name %></span>
            <% unless is_admin? %>
              <span class="text-xs font-semibold text-primary">Credits: <%= current_user.credit %></span>
            <% end %>
          </div>
          <% if is_admin? %>
            <button class="btn btn-warning btn-sm" onclick="deactivate_court_modal.showModal()">Deactivate Court</button>
          <% else %>
            <button class="btn btn-primary btn-sm" onclick="add_credit_modal.showModal()">Add Credit</button>
          <% end %>
          <%= link_to "Logout", logout_path, data: { turbo_method: :delete }, class: "btn btn-ghost btn-sm" %>
        <% else %>
          <%= form_with url: "/auth/keycloak", method: :post, local: true, data: { turbo: false } do |f| %>
            <%= f.submit "Login", class: "btn btn-primary btn-sm" %>
          <% end %>
        <% end %>
      </div>
    </div>
    
    <dialog id="add_credit_modal" class="modal">
      <div class="modal-box w-96">
        <h3 class="font-bold text-lg mb-4">Add Credits</h3>
        <%= form_with url: add_credit_users_path, method: :post, class: "space-y-4" do |f| %>
          <div class="form-control">
            <label class="label">
              <span class="label-text">Amount</span>
            </label>
            <%= f.number_field :amount, min: 1, class: "input input-bordered w-full", required: true %>
          </div>
          <div class="modal-action">
            <button type="button" class="btn" onclick="add_credit_modal.close()">Cancel</button>
            <%= f.submit "Add", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
    
    <% if is_admin? %>
    <dialog id="deactivate_court_modal" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">Deactivate Court</h3>
        <%= form_with url: deactivate_courts_path, method: :post, class: "space-y-4" do |f| %>
          <div class="form-control">
            <label class="label">
              <span class="label-text">Select Court</span>
            </label>
            <%= f.collection_select :court_id, @courts, :id, :name, {}, class: "select select-bordered w-full" %>
          </div>
          <div class="form-control">
            <label class="label">
              <span class="label-text">Date to Deactivate</span>
            </label>
            <%= f.date_field :date, class: "input input-bordered w-full", required: true, min: Date.current %>
          </div>
          <div class="modal-action">
            <button type="button" class="btn" onclick="deactivate_court_modal.close()">Cancel</button>
            <%= f.submit "Deactivate", class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
    <% end %>
    <%= render 'calendar' %>

    <%= render 'court_table' %>

</div>