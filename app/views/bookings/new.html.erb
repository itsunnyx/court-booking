<div class="w-full min-h-screen bg-base-200 flex items-center justify-center p-8">
  <div class="card w-96 bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl font-bold mb-4">Confirm Booking</h2>
      
      <div class="mb-6 space-y-2">
        <p class="text-lg"><span class="font-semibold text-base-content/70">Court:</span> <%= @court.name %></p>
        <p class="text-lg"><span class="font-semibold text-base-content/70">Date:</span> <%= @booking.time.strftime("%A, %b %d, %Y") %></p>
<p class="text-lg"><span class="font-semibold text-base-content/70">Time:</span> <%= @booking.time.strftime("%H:%M") %> - <%= (@booking.
  time + 1.hour).strftime("%H:%M") %></p>      </div>

      <%= form_with model: @booking, class: "space-y-4", data: { turbo: false } do |f| %>
        <%= f.hidden_field :court_id %>
        <%= f.hidden_field :time %>
        
        <div class="card-actions justify-end mt-4">
          <%= link_to "Cancel", root_path, class: "btn btn-ghost" %>
          <%= f.submit "Confirm Booking", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
